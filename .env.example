# App
NODE_ENV=development
PORT=3000

# CORS (production only — dev/test always allow all origins). Comma-separated
# list, e.g. the deployed admin portal domain(s). Unset in production means
# every cross-origin request is rejected, not allowed (see main.ts).
CORS_ALLOWED_ORIGINS=

# MongoDB (TRD §2 — primary datastore)
MONGODB_URI=mongodb://localhost:27017/ayuva

# Redis (TRD §2 — session/token cache, rate limiting, BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (TRD §6 — access/refresh tokens)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (TRD §8 — FR-1.3 social sign-in)
GOOGLE_CLIENT_ID=

# Object storage stand-in (TRD §2/§6 — FR-8.1/8.2 encrypted record uploads)
UPLOAD_DIR=./uploads
STORAGE_ENCRYPTION_KEY=

# Firebase Cloud Messaging (TRD §8 — FR-10.3 medication reminders, FR-7.6 appointment reminders)
# Leave unset for local dev/tests: NotificationsModule falls back to a log-only sender.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Allow the log-only push sender in production (e.g. free-tier staging without
# FCM). Unset/absent keeps the production fail-fast on missing credentials.
FCM_LOG_ONLY=
APPOINTMENT_REMINDER_LEAD_MINUTES=60
FOLLOW_UP_REMINDER_LEAD_DAYS=3
