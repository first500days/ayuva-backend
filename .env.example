# App
NODE_ENV=development
PORT=3000

# CORS (production only — dev/test always allow all origins). Comma-separated
# list, e.g. the deployed admin portal domain(s). Unset in production means
# every cross-origin request is rejected, not allowed (see main.ts).
CORS_ALLOWED_ORIGINS=

# MongoDB (TRD §2 — primary datastore)
MONGODB_URI=mongodb://localhost:27017/ayuva

# Redis (TRD §2 — session/token cache, rate limiting, BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (TRD §6 — access/refresh tokens)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (TRD §8 — FR-1.3 social sign-in)
# One client ID per platform, since the mobile app mints its ID token against
# whichever OAuth client matches the platform it's running on and
# GoogleAuthService verifies the token against all of them as valid audiences.
# These are read individually — there is no combined GOOGLE_CLIENT_ID. Leave
# all three unset and POST /auth/oauth/google returns 503 "Google OAuth is not
# configured on this server".
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Object storage stand-in (TRD §2/§6 — FR-8.1/8.2 encrypted record uploads)
UPLOAD_DIR=./uploads
STORAGE_ENCRYPTION_KEY=

# Firebase Cloud Messaging (TRD §8 — FR-10.3 medication reminders, FR-7.6 appointment reminders)
# Leave unset for local dev/tests: NotificationsModule falls back to a log-only sender.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Allow the log-only push sender in production (e.g. free-tier staging without
# FCM). Unset/absent keeps the production fail-fast on missing credentials.
FCM_LOG_ONLY=
# Optional. iOS devices register Expo tokens, which go through Expo's push service.
# Only needed if "Enhanced security for push" is on for the Expo project.
EXPO_ACCESS_TOKEN=
APPOINTMENT_REMINDER_LEAD_MINUTES=60
FOLLOW_UP_REMINDER_LEAD_DAYS=3

# SMS / WhatsApp via Twilio (optional — unset means log-only senders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
# WhatsApp sender number, e.g. whatsapp:+14155238886. Business-initiated
# WhatsApp messages need a Meta-approved template: set its Content SID
# (one variable: the app link). Without it, only in-session messages deliver.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# WhatsApp through Meta's Cloud API (takes priority over Twilio when set).
# WHATSAPP_TEMPLATE_REPORT: generic text and one URL button ending in {{1}},
# e.g. https://your-portal/v/{{1}}. WHATSAPP_TEMPLATE_NOTICE: one body variable.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TEMPLATE_REPORT=
WHATSAPP_TEMPLATE_NOTICE=
# Link sent with "new prescription" notices (patient app page)
PATIENT_APP_URL=

# Mail (for password reset emails via Resend)
RESEND_API_KEY=
# Used instead of Resend when set.
SENDGRID_API_KEY=
MAIL_FROM=noreply@ayuva.com
FRONTEND_URL=http://localhost:3000

# Secure report links sent by WhatsApp and email. Lifetime is held to 15-30 minutes.
# Without a secret, one is derived from JWT_ACCESS_SECRET.
REPORT_LINK_SECRET=
REPORT_LINK_TTL_MINUTES=
